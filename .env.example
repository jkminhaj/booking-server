# --- Database ---
DATABASE_URL=

# --- Server ---
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API with credentials (your frontend URL(s)).
CORS_ORIGIN=http://localhost:5173

# --- Auth (JWT) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT long random values. Never reuse one secret for both.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Payments (Stripe) ---
# From the Stripe dashboard (use test keys while developing).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
DEFAULT_CURRENCY=gbp
